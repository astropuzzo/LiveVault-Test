# OpenAstro NINA Monitor — standalone Docker module
# Copy to .env and keep chmod 600.

# Browser-facing monitor port on the ASIAIR/OpenAstro host.
NINA_MONITOR_BIND_ADDR=0.0.0.0
NINA_MONITOR_PORT=9091

# Inside-container listener. Leave these values unchanged for normal compose use.
OPENASTRO_NINA_MONITOR_HOST=0.0.0.0
OPENASTRO_NINA_MONITOR_PORT=9091

# PBKDF2 password hash generated by scripts/install-nina-monitor.sh.
OPENASTRO_NINA_MONITOR_PASSWORD_HASH=

# Random >=32-char HMAC secret for signed login sessions.
OPENASTRO_NINA_MONITOR_SECRET=

# Set to 1 only when this container itself is reached through HTTPS and the
# browser sees HTTPS at the container boundary/reverse proxy.
OPENASTRO_NINA_MONITOR_COOKIE_SECURE=0

# Explicit parent origins allowed to embed the monitor. Default remains deny-all.
OPENASTRO_NINA_MONITOR_FRAME_ANCESTORS='none'

# QSM bridge on the Windows N.I.N.A. PC. Prefer LAN or Tailscale; do not expose
# QSM port 18973 to the public Internet.
OPENASTRO_NINA_QSM_URL=http://192.168.1.50:18973
OPENASTRO_NINA_QSM_TOKEN=
