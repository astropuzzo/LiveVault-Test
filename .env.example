# Required. scripts/install.sh generates safe values for both.
APP_PASSWORD=
APP_PASSWORD_HASH=CHANGE_ME
APP_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Initial defaults. After first boot these can be changed live from Settings.
TZ=Europe/Brussels
POLL_SECONDS=60
MAX_PROBE_CONCURRENCY=4
SEGMENT_MINUTES=60
SEGMENT_MAX_GB=2
CONTAINER_FORMAT=mp4
INTEGRITY_MODE=packet
GENERATE_THUMBNAILS=true
BUFFER_MAX_GB=12
BUFFER_HARD_STOP=true
MIN_FREE_GB=3
CRITICAL_FREE_GB=1.5
EMERGENCY_FREE_GB=0.75
DELETE_AFTER_UPLOAD=true
UPLOAD_RETRY_SECONDS=180
MAX_UPLOAD_ATTEMPTS=12

# Uploader defaults. Tokens may instead be entered securely in Settings after login.
PRIMARY_UPLOADER=gofile
FALLBACK_UPLOADER=pixeldrain
GOFILE_TOKEN=
GOFILE_FOLDER_ID=
GOFILE_REGION=auto
PIXELDRAIN_API_KEY=

# Set true only when an HTTPS reverse proxy terminates TLS in front of LiveVault.
COOKIE_SECURE=false

# Public host binding
BIND_ADDR=0.0.0.0
BIND_PORT=8080

# Optional HTTPS hostname used by the Caddy compose overlay.
DOMAIN=
