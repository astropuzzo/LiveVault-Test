# Required. scripts/install.sh generates safe values for both.
APP_PASSWORD=
APP_PASSWORD_HASH=CHANGE_ME
APP_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Recorder
TZ=Europe/Brussels
POLL_SECONDS=60
MAX_PROBE_CONCURRENCY=4
SEGMENT_MINUTES=30
MIN_FREE_GB=5
CRITICAL_FREE_GB=2
EMERGENCY_FREE_GB=1
DELETE_AFTER_UPLOAD=true
UPLOAD_RETRY_SECONDS=300
MAX_UPLOAD_ATTEMPTS=12

# Uploader order: gofile / pixeldrain / none
PRIMARY_UPLOADER=gofile
FALLBACK_UPLOADER=pixeldrain

# Gofile: token account consigliato. Guest upload resta disabilitato di default.
GOFILE_TOKEN=
ALLOW_GOFILE_GUEST=false
GOFILE_FOLDER_ID=
GOFILE_UPLOAD_ENDPOINT=https://upload.gofile.io/uploadfile

# Pixeldrain: API key is required for uploads.
PIXELDRAIN_API_KEY=

# Set true only when an HTTPS reverse proxy terminates TLS in front of LiveVault.
COOKIE_SECURE=false

# Public host binding
BIND_ADDR=0.0.0.0
BIND_PORT=8080

# Optional HTTPS hostname used by the Caddy compose overlay.
DOMAIN=
