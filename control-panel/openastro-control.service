[Unit]
Description=OpenAstro mobile server control panel
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=astro
Group=astro
SupplementaryGroups=docker
WorkingDirectory=/opt/openastro-control
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/openastro-control/upload_server.py
Restart=always
RestartSec=3
TimeoutStopSec=10
ProtectHome=tmpfs
# Biglie's Oracle slot hunt (status, log, pause flag) is the only part of /home the panel sees.
BindPaths=-/home/astro/biglie-oci
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=160M
StateDirectory=openastro-control
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
