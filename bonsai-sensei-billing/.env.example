# Default preparation only. Blank credentials and empty catalog disable billing.
BILLING_ENABLED=false
PLAY_PACKAGE_NAME=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/play-service-account.json
ACCOUNT_HMAC_KEY_FILE=/run/secrets/account-hmac.key
TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/token-encryption.key
CATALOG_PATH=/config/catalog.json
DATABASE_PATH=/data/bonsai-sensei/billing.sqlite3
PORT=8095
# Optional authenticated Google Pub/Sub push. All three must be configured.
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT_EMAIL=
RTDN_SUBSCRIPTION=
# Internal aggregate statistics; independent from enabled purchases.
ADMIN_STATS_KEY_FILE=/run/secrets/admin-stats.key
